# ====== Wajib ======
# URL aplikasi (tanpa garis miring di akhir), mis. https://smartsign.vercel.app
APP_URL=http://localhost:3000
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
# Supabase: Project Settings > Database > Connection string > Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Rahasia acak minimal 32 karakter: openssl rand -hex 32
APP_SECRET=
# Email admin platform (pisahkan dengan koma)
SUPERADMIN_EMAILS=

# ====== Email transaksional (OTP tanda tangan, undangan) ======
# smtp(s)://user:pass@host:port, mis. smtps://resend:API_KEY@smtp.resend.com:465
SMTP_URL=
MAIL_FROM=SmartSign <no-reply@domainanda.id>

# ====== Opsional ======
# Domain pendek khusus, mis. https://s.domainanda.id (arahkan ke proyek Vercel yang sama)
SHORT_DOMAIN=
# Google Safe Browsing API key untuk pemeriksaan URL
SAFE_BROWSING_KEY=
# Rahasia untuk Vercel Cron (Vercel mengirim Authorization: Bearer CRON_SECRET)
CRON_SECRET=

# ====== Pembayaran Mayar.id ======
# API key: dashboard Mayar → Integration → API Key
MAYAR_API_KEY=
# Produksi: https://api.mayar.id/hl/v1  · Sandbox: https://api.mayar.io/hl/v1
MAYAR_API_BASE=https://api.mayar.id/hl/v1
# Token acak; daftarkan webhook di Mayar: https://<APP_URL>/api/webhooks/mayar?token=<MAYAR_WEBHOOK_TOKEN>
MAYAR_WEBHOOK_TOKEN=
